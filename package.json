{
  "name": "loam-keycard",
  "version": "0.3.0",
  "description": "A Status Keycard as a Loam signing identity — raw NFC driver + enrollment/session custody. Sibling to loam-transport / loam-sync.",
  "keywords": [
    "loam",
    "logos",
    "keycard",
    "status",
    "secp256k1",
    "signer",
    "identity",
    "react-native"
  ],
  "license": "MIT",
  "author": "vpavlin <vaclav@status.im>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vpavlin/loam-keycard"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@noble/curves": "^1.9.0 || ^2.0.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "*",
    "expo-crypto": "*",
    "expo-secure-store": "*",
    "keycard-sdk": "^3.1.9",
    "react": "*",
    "react-native": "*",
    "react-native-keycard": "^1.0.4",
    "@scure/bip32": "^1.7.0 || ^2.0.0",
    "@scure/bip39": "^1.6.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": false
    }
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0"
  }
}
